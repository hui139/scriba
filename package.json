{
  "name": "scriba",
  "version": "0.2.0",
  "description": "Scriba - an open-source, plugin-driven Markdown editor",
  "main": "./out/main/index.js",
  "author": "Scriba Contributors",
  "license": "MIT",
  "homepage": "https://github.com/hui139/scriba",
  "repository": {
    "type": "git",
    "url": "https://github.com/hui139/scriba.git"
  },
  "bugs": {
    "url": "https://github.com/hui139/scriba/issues"
  },
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "wysiwyg",
    "plugin"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/dev.mjs preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "smoke": "electron scripts/ui-smoke.cjs",
    "test:compat": "node scripts/test-compat.mjs",
    "test": "npm run test:compat && npm run test:plugins && npm run smoke",
    "index": "node scripts/build-index.mjs",
    "icons": "python scripts/build-icons.py",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:plugins": "node scripts/test-plugin-api.mjs"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.1",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.3",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@lezer/highlight": "^1.2.1",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "dompurify": "^3.1.7",
    "electron-vite": "^2.3.0",
    "katex": "^0.16.11",
    "marked": "^14.1.3",
    "mermaid": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "zustand": "^5.0.0"
  }
}
